{
  "expo": {
    "name": "Brand Gallery Admin",
    "slug": "brand-gallery-admin",
    "version": "1.0.3",
    "main": "expo-router/entry",
    "scheme": "adminpanel",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpeg",
    "owner": "slliman",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shahsuliman.adminpanel",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "notification": {
        "icon": "./assets/ic_stat_onesignal_default.png",
        "color": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.jpeg"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Brand Gallery to access your location for delivery."
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod\n-keep class kotlin.Metadata { *; }\n-keep class * implements expo.modules.kotlin.records.Record { *; }\n-keep class * extends expo.modules.kotlin.sharedobjects.SharedObject"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "onnxruntime-react-native",
      "./plugins/with-onnxruntime",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": [
            "./assets/ic_stat_onesignal_default.png"
          ],
          "smallIconAccentColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "e3d802e0-664f-4952-9c42-7b7effde4866",
      "eas": {
        "projectId": "4b3b0d77-5bcc-4e42-9c65-2fc7d07d06bc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4b3b0d77-5bcc-4e42-9c65-2fc7d07d06bc"
    }
  }
}
