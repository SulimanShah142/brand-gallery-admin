{
  "expo": {
    "name": "Brand Gallery Admin",
    "slug": "admin-panel",
    "version": "1.0.1",
    "main": "expo-router/entry",
    "scheme": "adminpanel",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpeg",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.shahsuliman.adminpanel",
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.jpeg"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Brand Gallery to access your location for delivery."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.jpeg",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/28c9f1fe-02db-4579-bc12-8d4615bb896b"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "e3d802e0-664f-4952-9c42-7b7effde4866",
      "eas": {
        "projectId": "28c9f1fe-02db-4579-bc12-8d4615bb896b"
      }
    },
    "owner": "slliman",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
